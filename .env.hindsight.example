# LOCAL DEVELOPMENT TEMPLATE — copy to .env.hindsight and replace the values.
# This file is delivered only to the private Hindsight container. Never merge it
# into .env, WEB_ENV_FILE, WORKER_ENV_FILE, browser configuration, or logs.
HINDSIGHT_API_LLM_PROVIDER=openai
HINDSIGHT_API_LLM_MODEL=gpt-4o-mini
HINDSIGHT_API_LLM_API_KEY=replace-with-a-local-development-provider-key
# An OpenAI-compatible gateway (for example OpenRouter) instead sets
# HINDSIGHT_API_LLM_BASE_URL to the gateway chat-completions origin.
# HINDSIGHT_API_LLM_BASE_URL=https://openrouter.ai/api/v1
# The pinned full image supplies local embeddings and reranking. Do not add
# separate embedding/reranker provider credentials unless deployment policy changes.
HINDSIGHT_API_EMBEDDINGS_PROVIDER=local
HINDSIGHT_API_RERANKER_PROVIDER=local
