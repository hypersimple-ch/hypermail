    "@ai-sdk/openai": "4.0.83",
    "@ai-sdk/provider": "4.0.21",
    "@hypermail/agent": "workspace:*",
    "@hypermail/auth": "workspace:*",
    "@hypermail/contracts": "workspace:*",
    "@hypermail/db": "workspace:*",
    "@hypermail/hypermail": "workspace:*",
    "@hypermail/notifications": "workspace:*",
    "@hypermail/observability": "workspace:*",
    "@hypermail/policy": "workspace:*",
    "@mastra/core": "1.74.0",
    "@mastra/memory": "1.35.0",
    "@mastra/pg": "1.29.0",
    "@openai/codex": "0.160.0",
    "@vectorize-io/hindsight-client": "0.10.2",
    "pg-boss": "12.36.0",
    "postgres": "3.4.9"
