{
  "name": "@hypermail/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "rm -rf dist && tsc -b tsconfig.json --force && cp -R static/. dist/ && esbuild src/browser.tsx --bundle --format=esm --platform=browser --define:process.env.NODE_ENV='\"production\"' --minify --splitting --outdir=dist --entry-names=app --chunk-names=chunks/[name]-[hash] && esbuild src/pwa/service-worker.ts --bundle --format=esm --platform=browser --minify --outfile=dist/pwa/service-worker.js && tailwindcss -i src/styles/globals.css -o dist/app.css --minify && test -f dist/index.js && node -e \"import('./dist/index.js')\" && test -f dist/app.js && test -f dist/app.css",
    "test": "cd ../.. && vitest run"
  },
  "dependencies": {
    "@heroui/react": "3.2.6",
    "@heroui/styles": "3.2.6",
    "@hypermail/agent-connections": "workspace:*",
    "@hypermail/auth": "workspace:*",
    "@hypermail/contracts": "workspace:*",
    "@hypermail/db": "workspace:*",
    "@hypermail/hypermail": "workspace:*",
    "@hypermail/notifications": "workspace:*",
    "@hypermail/observability": "workspace:*",
    "@hypermail/send": "workspace:*",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@tiptap/extension-text-align": "3.31.4",
    "@tiptap/extension-text-style": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/react": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "clsx": "2.1.1",
    "lucide-react": "1.52.0",
    "marked": "18.0.14",
    "postgres": "3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sanitize-html": "2.18.0",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sanitize-html": "2.16.2",
    "esbuild": "0.28.2",
    "jsdom": "30.1.2",
    "tailwindcss": "4.3.3"
  }
}
