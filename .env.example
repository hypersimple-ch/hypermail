# LOCAL DEVELOPMENT ONLY — these fixed values are intentionally unsafe for production.
# Copy this file to .env. Do not deploy it or reuse any value outside a local checkout.
NODE_ENV=development
POSTGRES_PASSWORD=hypermail-local-development-password-do-not-use
DATABASE_URL=postgresql://hypermail:hypermail-local-development-password-do-not-use@postgres:5432/hypermail
APP_ORIGIN=http://localhost:8080
# Direct development server trusts no forwarded headers. Compose pins and trusts only its proxy /32.
TRUSTED_PROXY_CIDRS=
# VPS Compose requires operator-selected, non-overlapping edge subnet and proxy address.
# EDGE_PROXY_SUBNET=
# EDGE_PROXY_IP=
AUTH_SECRET=dev-only-auth-secret-not-for-production-please-replace
OAUTH_TOKEN_HASH_KEY=dev-only-oauth-token-hash-key-distinct-000000000000
# Web-only recovery SMTP. Unset host/from keeps login usable but recovery degraded.
# RECOVERY_SMTP_HOST=mailpit
RECOVERY_SMTP_PORT=587
RECOVERY_SMTP_SECURE=false
# RECOVERY_SMTP_USER=
# RECOVERY_SMTP_PASSWORD=
# RECOVERY_FROM=owner@localhost.test
# Production: validated TLS on 465 (secure=true) or STARTTLS on 587.
HYPERMAIL_URL=http://hypermail:3000/mcp
HYPERMAIL_KEY=dev-only-hypermail-key-not-for-production-12345
# Optional Gmail OAuth bootstrap. Leave the client fields empty when Gmail is unavailable.
# Compose passes these only to the private Hypermail service.
HYPERMAIL_GMAIL_CLIENT_ID=
HYPERMAIL_GMAIL_CLIENT_SECRET=
HYPERMAIL_GMAIL_REDIRECT_URI=http://localhost:8080/oauth/gmail/callback
# Verified for local initialization against the pinned v0.7.26 image; not production contract acceptance.
HYPERMAIL_PROTOCOL_VERSION=2025-11-25
# Worker-only Hindsight client contract. Keep an optional HINDSIGHT_API_KEY in the
# worker env file only when an auth-enabled private endpoint requires it.
HINDSIGHT_URL=http://hindsight:8888
HINDSIGHT_EXPECTED_VERSION=0.9.1
HINDSIGHT_REQUEST_TIMEOUT_MS=30000
HINDSIGHT_MAX_FILE_BYTES=10485760
# Durable mailbox-memory delivery retries indefinitely with this capped backoff and fenced lease.
MAILBOX_MEMORY_RETRY_BASE_DELAY_SECONDS=5
MAILBOX_MEMORY_RETRY_MAXIMUM_DELAY_SECONDS=900
MAILBOX_MEMORY_CLAIM_LEASE_SECONDS=3600
MAILBOX_MEMORY_SCHEDULER_INTERVAL_SECONDS=5
# Hindsight service LLM credentials belong in a separate .env.hindsight file.
# Copy .env.hindsight.example and replace its provider values before Compose startup.
MODEL_PROVIDER=codex-cli
MODEL_NAME=default
# Codex uses host login auth; do not set MODEL_API_KEY for this local configuration.
AGENT_GLOBAL_CONSTRAINTS=local-development-owner-policy
VAPID_SUBJECT=mailto:owner@localhost.test
VAPID_PUBLIC_KEY=BHriVkOgFwVnaToFS1fLbNnUozLuJnajq4qPy7EDzeitTfofZ6HnjyAkE2frNUYNDKG71ksmG-p3bV0SQV0jQzk
VAPID_PRIVATE_KEY=lBerBF1EMcOtQi7FA8LlwddFlQHciWBgNDhgVYLn1l0
PUSH_SUBSCRIPTION_ENCRYPTION_KEY=2nHpblfrYxOkETUueAMEWejAGLmNPsgVpkAh5NiyYZA
ATTACHMENT_TEMP_DIRECTORY=/var/lib/hypermail-attachments
ATTACHMENT_MAX_BYTES=26214400
ATTACHMENT_ORPHAN_MAX_AGE_SECONDS=3600
HEALTH_PORT=3001
POLL_INTERVAL_SECONDS=45
LIFECYCLE_INTERVAL_SECONDS=3600
SHUTDOWN_TIMEOUT_SECONDS=30
BODY_RETENTION_DAYS=90
OAUTH_RETENTION_HOURS=24
SESSION_RETENTION_DAYS=30
TASK_PAYLOAD_RETENTION_DAYS=30
OPERATIONAL_TEXT_RETENTION_DAYS=14
LIFECYCLE_BATCH_SIZE=100
USER_TASK_RATE_PER_MINUTE=60
USER_TASK_CONCURRENCY=4
USER_PENDING_TASK_QUOTA=1000
ACTION_CONFIDENCE_THRESHOLD=0.60
INCORRECT_MUTATION_THRESHOLD=0.01
