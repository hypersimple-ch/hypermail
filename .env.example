# Copy only the variables needed by each service into deployment secrets.
# Never commit real values. Hypermail provider/OAuth credentials belong only in Hypermail state.
NODE_ENV=development
DATABASE_URL=postgresql://hypermail:REDACTED@postgres:5432/hypermail
APP_ORIGIN=https://mail.example.invalid
AUTH_SECRET=REDACTED_AT_LEAST_32_CHARACTERS
RECOVERY_RECIPIENT=owner@example.invalid
HYPERMAIL_URL=http://hypermail:3000/mcp
HYPERMAIL_KEY=REDACTED
# Must be validated against the deployed pinned Hypermail runtime; do not guess.
HYPERMAIL_PROTOCOL_VERSION=REDACTED
MODEL_PROVIDER=openai
MODEL_NAME=REDACTED
MODEL_API_KEY=REDACTED
AGENT_GLOBAL_CONSTRAINTS=REDACTED_OWNER_POLICY
VAPID_SUBJECT=mailto:owner@example.invalid
VAPID_PUBLIC_KEY=REDACTED
VAPID_PRIVATE_KEY=REDACTED
PUSH_SUBSCRIPTION_ENCRYPTION_KEY=REDACTED_AT_LEAST_32_CHARACTERS
ATTACHMENT_TEMP_DIRECTORY=/var/lib/hypermail-attachments
ATTACHMENT_MAX_BYTES=26214400
ATTACHMENT_ORPHAN_MAX_AGE_SECONDS=3600
# Optional as a pair. Omit both to disable sending fail-closed.
APPROVED_SEND_URL=https://approved-send.internal.example.invalid
APPROVED_SEND_TOKEN=REDACTED
HEALTH_PORT=3001
POLL_INTERVAL_SECONDS=45
LIFECYCLE_INTERVAL_SECONDS=3600
SHUTDOWN_TIMEOUT_SECONDS=30
BODY_RETENTION_DAYS=90
INCORRECT_MUTATION_THRESHOLD=0.01
BACKUP_TARGET=s3://REDACTED/hypermail
BACKUP_ENCRYPTION_KEY_FILE=/run/secrets/backup-database-key
BACKUP_STATE_ENCRYPTION_KEY_FILE=/run/secrets/backup-state-key
BACKUP_RETENTION_DAYS=30
