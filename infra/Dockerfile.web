# syntax=docker/dockerfile:1.7
FROM node:22.23.2-alpine AS build
WORKDIR /workspace
RUN corepack enable
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.json tsconfig.base.json ./
COPY apps ./apps
COPY packages ./packages
RUN pnpm install --frozen-lockfile
RUN pnpm --filter @hypermail/web... build
RUN pnpm --filter @hypermail/web deploy --prod --no-optional /opt/app

# Migrations retain the workspace's development-only Drizzle CLI and migration assets.
FROM build AS migrate
CMD ["pnpm", "--filter", "@hypermail/db", "db:migrate"]

FROM node:22.23.2-alpine AS runtime
ENV NODE_ENV=production
WORKDIR /app
# Runtime needs Node only; removing package managers shrinks the attack surface.
RUN rm -rf /usr/local/lib/node_modules /opt/yarn-* \
  && rm -f /usr/local/bin/corepack /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/pnpm /usr/local/bin/pnpx /usr/local/bin/yarn /usr/local/bin/yarnpkg \
  && addgroup -S hypermail \
  && adduser -S -G hypermail -u 10001 hypermail
COPY --from=build --chown=hypermail:hypermail /opt/app ./
USER hypermail
EXPOSE 3000
# Verify the Node host, not merely that its process still exists.
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 CMD node -e "fetch('http://127.0.0.1:3000/health/live').then((response) => process.exit(response.ok ? 0 : 1)).catch(() => process.exit(1))"
CMD ["node", "dist/index.js"]
