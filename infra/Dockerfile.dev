# syntax=docker/dockerfile:1.7
FROM node:22.23.2-alpine AS workspace
ENV NODE_ENV=development \
    PATH=/workspace/node_modules/.bin:$PATH \
    npm_config_inject_workspace_packages=false
WORKDIR /workspace
RUN corepack enable \
  && corepack prepare pnpm@11.11.0 --activate \
  && apk add --no-cache su-exec \
  && addgroup -S hypermail \
  && adduser -S -G hypermail -u 10001 hypermail \
  && chown hypermail:hypermail /workspace
COPY --chown=hypermail:hypermail package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.json tsconfig.base.json ./
COPY --chown=hypermail:hypermail apps ./apps
COPY --chown=hypermail:hypermail packages ./packages
COPY --chmod=0555 infra/worker-entrypoint.sh /usr/local/bin/worker-entrypoint
USER hypermail
# Symlink workspace dependencies so package watchers update live code. The lockfile copy may adapt only its workspace-link setting.
RUN --mount=type=cache,id=hypermail-dev-pnpm,target=/home/hypermail/.local/share/pnpm/store,uid=10001,gid=10001 \
  pnpm install --no-frozen-lockfile
COPY --chown=hypermail:hypermail infra/dev-runner.mjs ./infra/dev-runner.mjs
ARG DEV_INPUT_HASH=unknown
LABEL org.hypermail.dev-input-hash=$DEV_INPUT_HASH

FROM workspace AS web
RUN pnpm --filter @hypermail/web... build
EXPOSE 3000
HEALTHCHECK --interval=2s --timeout=2s --start-period=2s --retries=30 CMD node -e "fetch('http://127.0.0.1:3000/health/live').then((response) => process.exit(response.ok ? 0 : 1)).catch(() => process.exit(1))"
CMD ["node", "infra/dev-runner.mjs", "web"]

FROM workspace AS migrate
CMD ["pnpm", "--filter", "@hypermail/db", "db:migrate"]

FROM workspace AS worker
RUN pnpm --filter @hypermail/worker... build
USER root
EXPOSE 3001
HEALTHCHECK --interval=2s --timeout=2s --start-period=2s --retries=30 CMD node -e "fetch('http://127.0.0.1:3001/live').then((response) => process.exit(response.ok ? 0 : 1)).catch(() => process.exit(1))"
ENTRYPOINT ["/usr/local/bin/worker-entrypoint"]
CMD ["node", "infra/dev-runner.mjs", "worker"]
