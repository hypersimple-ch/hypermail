# syntax=docker/dockerfile:1.7
FROM node:22.23.2-alpine AS build
WORKDIR /workspace
RUN corepack enable
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/hypermail/package.json ./apps/hypermail/package.json
RUN pnpm install --frozen-lockfile
RUN pnpm --filter @hypermail/runtime deploy --prod --no-optional /opt/app

FROM node:22.23.2-alpine AS runtime
ENV NODE_ENV=production
WORKDIR /app
# Runtime needs Node only; Hypermail deliberately does not use optional keychain storage.
RUN rm -rf /usr/local/lib/node_modules /opt/yarn-* \
  && rm -f /usr/local/bin/corepack /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/pnpm /usr/local/bin/pnpx /usr/local/bin/yarn /usr/local/bin/yarnpkg \
  && addgroup -S hypermail \
  && adduser -S -G hypermail -u 10001 hypermail \
  && install -d -m 0700 -o hypermail -g hypermail /var/lib/hypermail
COPY --from=build --chown=hypermail:hypermail /opt/app ./
USER hypermail
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 CMD node -e "fetch('http://127.0.0.1:3000/mcp', {headers:{accept:'application/json, text/event-stream'}}).then((response) => process.exit(response.status === 400 ? 0 : 1)).catch(() => process.exit(1))"
CMD ["./node_modules/.bin/hypermail-mcp", "--http", "--host", "0.0.0.0", "--port", "3000", "--data-dir", "/var/lib/hypermail"]
